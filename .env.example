# Copy to .env (git-ignored) and fill in real values before running `docker compose up`.
#
# The api container never sees backend/src/Korner.Api/appsettings.Local.json — it's excluded from
# the build context by backend/.dockerignore, same as it's excluded from git. This file is what
# the containerized API reads its config from instead (docker-compose.yml passes it straight
# through via env_file), using the ASP.NET Core Section__Property convention. See docs/SECRETS.md
# for what each value is for; keep this in sync with appsettings.Local.json's section names.

MSSQL_SA_PASSWORD=change-me-strong-password

Jwt__Key=change-me-at-least-32-random-bytes-base64-or-hex
Jwt__Issuer=Korner
Jwt__Audience=Korner
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=15

Auth__CookieDomain=localhost
Auth__StorefrontOrigins__0=http://localhost:5173

Authentication__Google__ClientId=change-me.apps.googleusercontent.com
Authentication__Google__ClientSecret=change-me
Authentication__Google__RedirectUri=/signin-google
Authentication__Google__Scopes__0=openid
Authentication__Google__Scopes__1=profile
Authentication__Google__Scopes__2=email

MailSettings__Mail=change-me@example.com
MailSettings__DisplayName=Korner
MailSettings__Password=change-me
MailSettings__Host=smtp.gmail.com
MailSettings__Port=587

PaymobSettings__APIKey=change-me
PaymobSettings__SecretKey=change-me
PaymobSettings__PublicKey=change-me
PaymobSettings__HMAC=change-me
PaymobSettings__CardIntegrationId=0
# 0 = wallets disabled (a valid state, not an error — technical design §2.11).
PaymobSettings__MobileIntegrationId=0
PaymobSettings__IframeId=0
PaymobSettings__AuthCaptureIntegrationId=0
PaymobSettings__BaseUrl=https://accept.paymob.com/api/
PaymobSettings__ApiPublicUrl=https://CHANGE-ME.trycloudflare.com
PaymobSettings__StorefrontUrl=http://localhost:5173
PaymobSettings__InquiryPath=api/ecommerce/orders/transaction_inquiry
PaymobSettings__ReservationMinutes=15
PaymobSettings__MaxAttemptsPerOrder=5

HangfireSettings__Username=admin
HangfireSettings__Password=change-me

Storage__PublicBaseUrl=http://localhost:5080
